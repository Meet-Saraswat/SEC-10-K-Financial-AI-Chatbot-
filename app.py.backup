# ── Tabs ───────────────────────────────────────────────────────────────────────
tab_chat, tab_dashboard, tab_data = st.tabs(["💬 Chat", "📈 Dashboard", "🗄️ Data Explorer"])


# ══════════════════════════════════════════════════════════
#  TAB 1: CHAT
# ══════════════════════════════════════════════════════════
with tab_chat:

    # Initialise chat history in session state
    # session_state persists across Streamlit reruns within one browser session
    if "messages" not in st.session_state:
        st.session_state.messages = []

    # Welcome message (only shown on first load)
    if not st.session_state.messages:
        with st.chat_message("assistant"):
            st.markdown("""
👋 **Welcome to the Financial AI Chatbot!**

I can answer questions about **Tesla, Microsoft, and Apple** using real SEC 10-K filings.

I use the following architecture to answer your questions:
- **Financial questions** → SQLite database (XBRL data) + Python calculations
- **Text questions** → ChromaDB vector search (RAG from 10-K text)
- **Mixed questions** → Both sources combined

Try asking something from the sidebar examples!
            """)

    # Display chat history
    for message in st.session_state.messages:
        with st.chat_message(message["role"]):
            st.markdown(message["content"])

            # Show routing info below assistant messages
            if message["role"] == "assistant" and message.get("routing"):
                r = message["routing"]
                col_a, col_b, col_c = st.columns([1, 1, 2])
                with col_a:
                    st.caption(f"🎯 **Route:** {r['type']}")
                with col_b:
                    st.caption(f"🏢 **Companies:** {', '.join(r['companies'])}")
                with col_c:
                    st.caption(f"📅 **Years:** {', '.join(map(str, r['years']))}")

    # ── Chat Input ─────────────────────────────────────────
    prefill = st.session_state.pop("prefill_question", "")
    question = st.chat_input("Ask about financials, risks, growth, comparisons...")

    # Allow pre-filled questions from sidebar buttons
    if prefill:
        question = prefill

    # ── Process a new question ─────────────────────────────
    if question:
        # Guard: check Ollama is running
        if not ollama_ok:
            st.error(
                "❌ Ollama is not running. "
                "Open a Terminal and run: `ollama serve`"
            )
            st.stop()

        # Guard: check data is loaded
        if not db_ok:
            st.error(
                "❌ No financial data found. "
                "Run: `python ingest_data.py --xbrl-only`"
            )
            st.stop()

        # Show the user's message
        with st.chat_message("user"):
            st.markdown(question)

        # Save to history
        st.session_state.messages.append({
            "role": "user", "content": question
        })

        # ── Show architecture routing ──────────────────────
        from src.chains.intent_detector import detect_intent, QueryType
        intent = detect_intent(question)
        qtype  = intent["type"]

        # Map type to human-readable routing description
        routing_descriptions = {
            QueryType.FINANCIAL: "🗄️ SQLite → 🔢 Python Calculations → 🤖 Ollama",
            QueryType.TEXTUAL:   "🔍 ChromaDB RAG → 🤖 Ollama",
            QueryType.MIXED:     "🗄️ SQLite + 🔍 ChromaDB → 🔢 Calculations → 🤖 Ollama",
        }

        # ── Generate the response ──────────────────────────
        with st.chat_message("assistant"):
            # Show routing badge
            st.caption(
                f"**Routing:** {routing_descriptions.get(qtype, qtype)} "
                f"· Model: `{os.getenv('LLM_MODEL', 'llama3.2:3b')}`"
            )

            # Streaming response placeholder
            response_placeholder = st.empty()
            full_response = ""

            try:
                from src.chains.chatbot_engine import ask

                # Check if textual question but no vector store
                if qtype == QueryType.TEXTUAL and not vs_ok:
                    full_response = (
                        "⚠️ This question requires 10-K text search (RAG), but the "
                        "vector store is empty.\n\n"
                        "Run `python ingest_data.py` (without --xbrl-only) to enable "
                        "text-based queries, then ask again."
                    )
                    response_placeholder.markdown(full_response)
                else:
                    # Stream the response chunk by chunk
                    for chunk in ask(question, stream=True):
                        full_response += chunk
                        # Show response with a blinking cursor while streaming
                        response_placeholder.markdown(full_response + "▌")

                    # Remove cursor when done
                    response_placeholder.markdown(full_response)

            except Exception as e:
                full_response = f"❌ Error: {str(e)}\n\nCheck that Ollama is running: `ollama serve`"
                response_placeholder.error(full_response)

        # Save assistant response + routing info to history
        st.session_state.messages.append({
            "role":    "assistant",
            "content": full_response,
            "routing": intent,
        })

    # Clear button
    if st.session_state.messages:
        st.markdown("---")
        if st.button("🗑️ Clear conversation", type="secondary"):
            st.session_state.messages = []
            st.rerun()


# ══════════════════════════════════════════════════════════
#  TAB 2: DASHBOARD
# ══════════════════════════════════════════════════════════
with tab_dashboard:

    if not db_ok:
        st.info("📊 Run `python ingest_data.py --xbrl-only` to load data and see charts here.")
        st.stop()

    from src.database.db_manager import get_metric
    from src.chains.calculator import format_currency
    from src.database.db_manager import sql_gross_margin, sql_multi_year_trend

    COMPANIES = ["Tesla", "Microsoft", "Apple"]
    COLORS    = {"Tesla": "#CC0000", "Microsoft": "#00A4EF", "Apple": "#555555"}

    # ── Revenue Trend ──────────────────────────────────────
    st.subheader("📈 Revenue Trend (all years)")
    rev_data = []
    for company in COMPANIES:
        rows = get_metric(company, "Revenue")
        for r in rows:
            rev_data.append({
                "Company":      company,
                "Year":         r["year"],
                "Revenue ($B)": r["value"] / 1e9,
            })

    if rev_data:
        df_rev = pd.DataFrame(rev_data)
        fig_rev = px.line(
            df_rev, x="Year", y="Revenue ($B)", color="Company",
            color_discrete_map=COLORS, markers=True,
            title="Annual Revenue ($B)",
        )
        fig_rev.update_layout(hovermode="x unified", height=400)
        st.plotly_chart(fig_rev, use_container_width=True)

    # ── Key Metrics 2023 ──────────────────────────────────
    st.subheader("🏆 Key Metrics — 2023")
    cols = st.columns(3)
    for i, company in enumerate(COMPANIES):
        with cols[i]:
            icon = {"Tesla": "🚗", "Microsoft": "💻", "Apple": "🍎"}[company]
            st.markdown(f"### {icon} {company}")

            for metric in ["Revenue", "Net Income", "Gross Profit"]:
                rows = get_metric(company, metric, 2023)
                if rows:
                    val = rows[0]["value"]
                    unit = rows[0].get("unit", "USD")
                    delta_rows = get_metric(company, metric, 2022)
                    delta = None
                    if delta_rows:
                        pct = (val - delta_rows[0]["value"]) / abs(delta_rows[0]["value"]) * 100
                        delta = f"{pct:+.1f}% vs 2022"
                    st.metric(metric, format_currency(val, unit), delta=delta)

    # ── Side-by-side bar charts ────────────────────────────
    col_left, col_right = st.columns(2)

    with col_left:
        st.subheader("💰 Net Income Comparison (2023)")
        ni_data = []
        for company in COMPANIES:
            rows = get_metric(company, "Net Income", 2023)
            if rows:
                ni_data.append({
                    "Company": company,
                    "Net Income ($B)": rows[0]["value"] / 1e9,
                })
        if ni_data:
            df_ni = pd.DataFrame(ni_data).sort_values("Net Income ($B)", ascending=False)
            fig_ni = px.bar(
                df_ni, x="Company", y="Net Income ($B)",
                color="Company", color_discrete_map=COLORS,
                text_auto=".1f",
            )
            fig_ni.update_traces(texttemplate="$%{y:.1f}B", textposition="outside")
            st.plotly_chart(fig_ni, use_container_width=True)

    with col_right:
        st.subheader("📐 Gross Margin % (2021–2023)")
        margin_data = []
        for company in COMPANIES:
            rev_rows  = get_metric(company, "Revenue")
            cogs_rows = get_metric(company, "Cost of Revenue")
            for year in [2021, 2022, 2023]:
                gm = sql_gross_margin(rev_rows, cogs_rows, year)
                if gm:
                    margin_data.append({
                        "Company": company, "Year": year,
                        "Gross Margin (%)": round(gm, 1),
                    })
        if margin_data:
            df_gm = pd.DataFrame(margin_data)
            fig_gm = px.bar(
                df_gm, x="Year", y="Gross Margin (%)", color="Company",
                barmode="group", color_discrete_map=COLORS, text_auto=True,
            )
            st.plotly_chart(fig_gm, use_container_width=True)

    # ── R&D Spending ───────────────────────────────────────
    st.subheader("🔬 R&D Expense Trend")
    rd_data = []
    for company in COMPANIES:
        rows = get_metric(company, "R&D Expense")
        for r in rows:
            rd_data.append({
                "Company":    company,
                "Year":       r["year"],
                "R&D ($B)":   r["value"] / 1e9,
            })
    if rd_data:
        df_rd = pd.DataFrame(rd_data)
        fig_rd = px.bar(
            df_rd, x="Year", y="R&D ($B)", color="Company",
            barmode="group", color_discrete_map=COLORS,
            title="Research & Development Spending ($B)",
        )
        st.plotly_chart(fig_rd, use_container_width=True)


# ══════════════════════════════════════════════════════════
#  TAB 3: DATA EXPLORER
# ══════════════════════════════════════════════════════════
with tab_data:

    if not db_ok:
        st.info("Run `python ingest_data.py --xbrl-only` to load data.")
        st.stop()

    from src.database.db_manager import get_all_records, get_distinct_metrics
    from src.chains.calculator import format_currency

    st.subheader("🗄️ Raw Financial Data Explorer")

    # ── Filters ───────────────────────────────────────────
    col_a, col_b, col_c = st.columns(3)
    with col_a:
        filter_companies = st.multiselect(
            "Company", ["Tesla", "Microsoft", "Apple"],
            default=["Tesla", "Microsoft", "Apple"]
        )
    with col_b:
        all_metrics = get_distinct_metrics()
        filter_metrics = st.multiselect(
            "Metric", all_metrics,
            default=["Revenue", "Net Income"] if "Revenue" in all_metrics else []
        )
    with col_c:
        filter_years = st.multiselect(
            "Year", [2019, 2020, 2021, 2022, 2023],
            default=[2021, 2022, 2023]
        )

    # ── Fetch + Filter ─────────────────────────────────────
    all_records = get_all_records()
    df = pd.DataFrame(all_records)

    if not df.empty:
        # Apply filters
        df_filtered = df[
            df["company"].isin(filter_companies) &
            df["year"].isin(filter_years)
        ]
        if filter_metrics:
            df_filtered = df_filtered[df_filtered["metric"].isin(filter_metrics)]

        # Add formatted value column
        df_filtered = df_filtered.copy()
        df_filtered["Formatted Value"] = df_filtered.apply(
            lambda row: format_currency(row["value"], row.get("unit", "USD")), axis=1
        )

        # Display
        st.dataframe(
            df_filtered[["company", "year", "metric", "Formatted Value", "unit"]].rename(
                columns={
                    "company": "Company",
                    "year":    "Year",
                    "metric":  "Metric",
                    "unit":    "Unit",
                }
            ).sort_values(["Company", "Metric", "Year"]),
            use_container_width = True,
            height              = 500,
        )
        st.caption(
            f"Showing {len(df_filtered):,} of {len(df):,} total records · "
            f"Source: SEC EDGAR XBRL"
        )

    # ── Vector store info ─────────────────────────────────
    if vs_ok:
        st.subheader("🔍 Vector Store (RAG)")
        from src.ingestion.vector_store import get_store_stats
        stats = get_store_stats()
        c1, c2, c3 = st.columns(3)
        c1.metric("Total Chunks", f"{stats['total_chunks']:,}")
        c2.metric("Companies",    ", ".join(str(c) for c in stats["companies"]))
        c3.metric("Sections",     len(stats.get("sections", [])))
    else:
        st.info("🔍 Vector store empty — run `python ingest_data.py` for RAG support")
